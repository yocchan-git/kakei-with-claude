# ============================================================
# 通知設定（週次・月初リマインダーの送信先）
# .env.example をコピーして .env を作成し、使うものだけ埋めてください。
# ※ セットアップは Claude Code に「/setup」と打てば全部案内してくれます。
# ============================================================

# 通知プロバイダ: discord（推奨）/ slack / chatwork / console
# 未設定・送信先未入力でもエラーにはならず、コンソール出力にフォールバックします。
NOTIFY_PROVIDER=discord

# --- Discord（推奨・最も簡単。トークン不要）---
# Discord アプリ → サーバー設定 → 連携サービス → ウェブフック →「新しいウェブフック」
# →「ウェブフックURLをコピー」した値を貼り付け。
DISCORD_WEBHOOK_URL=

# --- Slack を使う場合 ---
# https://api.slack.com/messaging/webhooks で発行した Incoming Webhook URL
# SLACK_WEBHOOK_URL=

# --- Chatwork を使う場合 ---
# CHATWORK_API_TOKEN=
# CHATWORK_ROOM_ID=
